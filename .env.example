# Sao chép thành .env rồi điền. Lưu bằng UTF-8 (Notepad mặc định thêm BOM — code đã xử lý).

# --- Thông báo đẩy (GitHub Actions đọc từ Secrets; local chỉ để thử) ---
# Sinh bằng: venv\Scripts\python -m job.gen_vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# --- Cloudflare Worker (tuỳ chọn, chưa dùng) ---
WORKER_URL=
WORKER_TOKEN=
# Dự phòng khi không có Worker: JSON mảng subscription (lấy từ tab Cài đặt trên điện thoại)
PUSH_SUBS_FALLBACK=

# --- Chung ---
HTTP_TIMEOUT=30
# Danh mục theo dõi: các mã cách nhau bởi dấu phẩy. Local đọc dòng này; trên GitHub là
# Actions Variable cùng tên WATCHLIST (dán từ nút "Chuẩn hoá & sao chép" ở tab Cài đặt).
WATCHLIST=HPG, VNM
